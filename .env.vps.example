# ===== ACESSO PÚBLICO (SEM DOMÍNIO) =====
PUBLIC_IP=203.0.113.10
TZ=America/Belem

# ===== DJANGO =====
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=troque-esta-senha
DJANGO_ADMIN_EMAIL=admin@localhost

# ===== POSTGRESQL =====
POSTGRES_DB=painel_motoristas
POSTGRES_USER=painel
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ===== SSW / ROBÔ 036 =====
SSW_EMPRESA=
SSW_CPF=
SSW_USUARIO=
SSW_SENHA=
SSW_URL=https://sistema.ssw.inf.br/bin/ssw0422
SSW_UNIT=BEL
ROBOT_HEADLESS=true
ROBOT_SLOW_MO=800
ROBOT_ACTION_TIMEOUT_MS=30000
ROBOT_DOWNLOAD_TIMEOUT_MS=120000

# Automação inicial. Depois pode ser alterada pelo próprio Painel.
SSW_AUTO_SYNC_ENABLED=1
SSW_AUTO_SYNC_INTERVAL_MINUTES=60

# ===== WHATSAPP / BAILEYS =====
WHATSAPP_SEND_DELAY_MS=2500
WHATSAPP_BAILEYS_LOG_LEVEL=warn
