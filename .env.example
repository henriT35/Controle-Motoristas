DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://painel:painel@db:5432/painel_motoristas
REDIS_URL=redis://redis:6379/0
TZ=America/Belem
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=Painel@2026!
LOCAL_ADMIN_EMAIL=admin@localhost
SSW_USERNAME=
SSW_PASSWORD=

SSW_IMPORT_ENGINE=v2

SSW_IMPORT_TIMEOUT_SECONDS=3600
SSW_ROBOT_HEARTBEAT_SECONDS=10
