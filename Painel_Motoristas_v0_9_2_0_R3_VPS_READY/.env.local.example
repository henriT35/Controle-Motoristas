DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_MODE=sqlite
SQLITE_PATH=local_data/painel_motoristas.sqlite3
CELERY_TASK_ALWAYS_EAGER=1
TZ=America/Belem
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=Painel@2026!
LOCAL_ADMIN_EMAIL=admin@localhost
SSW_USERNAME=
SSW_PASSWORD=

# Robô SSW (credenciais continuam configuradas dentro do próprio robô, não no Painel)
SSW_ROBOT_ENABLED=0
SSW_ROBOT_DIR=robot_ssw
SSW_ROBOT_DISPATCH_MODE=local_process
SSW_ROBOT_TIMEOUT_SECONDS=900
SSW_IMPORT_TIMEOUT_SECONDS=3600
SSW_ROBOT_HEARTBEAT_SECONDS=10
SSW_ROBOT_ORPHAN_GRACE_SECONDS=120
SSW_ROBOT_UNIT=BEL
SSW_ROBOT_OPTION=036
SSW_ROBOT_EXCEL=S
SSW_ROBOT_REPORT_TYPE=ROMANEIOS_036
# Opcional: sobrescreva a auto-detecção do entrypoint. Placeholders aceitos:
# {python} {task_file} {result_file} {download_dir} {execution_id} {start_date} {end_date} {unit} {option}
# SSW_ROBOT_COMMAND={python} main.py --task-file {task_file} --result-file {result_file}

# Motor de importação SSW: v2 otimizado (v1/legacy apenas para rollback temporário)
SSW_IMPORT_ENGINE=v2

# Mapa operacional geográfico (opcional)
GEO_DOMINANT_CITY_THRESHOLD=0.80
GEO_ALERT_MIN_SAMPLE=10
GEO_OUTLIER_DOMINANCE_THRESHOLD=0.70
GEO_OUTLIER_MIN_SHARE=0.02
GEO_HOME_STATE=PA
GEO_HOME_CITY=Belem

# URL pública fixa opcional. No EXECUTAR_ONLINE.bat ela é preenchida automaticamente no processo.
PANEL_PUBLIC_BASE_URL=
