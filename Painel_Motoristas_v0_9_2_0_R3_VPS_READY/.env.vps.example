# ==============================================================
# PAINEL MOTORISTAS v0.9.2.0 R3 - VPS SEM DOMÍNIO
# Copie para .env: cp .env.vps.example .env
# NUNCA versionar o .env real.
# ==============================================================

# ===== ACESSO PÚBLICO =====
PUBLIC_IP=203.0.113.10
TZ=America/Belem

# ===== DJANGO =====
# Gere uma chave forte, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=troque-esta-senha
DJANGO_ADMIN_EMAIL=admin@localhost

# ===== POSTGRESQL =====
POSTGRES_DB=painel_motoristas
POSTGRES_USER=painel
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ===== PERFORMANCE / WEB =====
# Bom ponto de partida para VPS com 4 GB RAM.
# Em VPS menor, use 2 workers. Em VPS maior, medir antes de aumentar.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=200
CACHE_TTL_SECONDS=900
PERF_SQL_LOG=0

# O startup prepara dados e cache antes de liberar o web para uso.
STARTUP_RECONCILE=1
STARTUP_SYNC_EVALUATION=1
STARTUP_WARMUP=1

# ===== SSW / ROBÔ 036 =====
SSW_EMPRESA=
SSW_CPF=
SSW_USUARIO=
SSW_SENHA=
SSW_URL=https://sistema.ssw.inf.br/bin/ssw0422
SSW_UNIT=BEL
ROBOT_HEADLESS=true
ROBOT_SLOW_MO=800
ROBOT_ACTION_TIMEOUT_MS=30000
ROBOT_DOWNLOAD_TIMEOUT_MS=120000

# Automação inicial. Depois pode ser alterada pelo próprio Painel.
SSW_AUTO_SYNC_ENABLED=1
SSW_AUTO_SYNC_INTERVAL_MINUTES=120

# ===== WHATSAPP / BAILEYS =====
WHATSAPP_SEND_DELAY_MS=2500
WHATSAPP_BAILEYS_LOG_LEVEL=warn
